{
  "name": "neo-desktop-calendar",
  "version": "1.2.3",
  "description": "Neo Desktop Calendar — desktop wallpaper calendar with click-through",
  "main": "./out/main/main.js",
  "author": "Neo Desktop Calendar",
  "license": "AGPL-3.0-only",
  "repository": {
    "type": "git",
    "url": "https://gitlab.aigov.go.kr/soonpyo/neo-desktop-calendar.git"
  },
  "scripts": {
    "dev": "electron-vite dev",
    "dev:restart": "node scripts/dev-restart.mjs",
    "browser:dev": "node scripts/open-browser-dev.mjs",
    "stop": "node scripts/kill-dev.mjs",
    "build": "electron-vite build",
    "build:desktop-hit": "node scripts/build-desktop-hit-helper.mjs",
    "preview": "electron-vite preview",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json",
    "typecheck": "npm run typecheck:node && npm run typecheck:web",
    "seed:holidays": "node scripts/build-holiday-seed.mjs",
    "verify:export": "node scripts/verify-export.mjs",
    "sync-version": "node scripts/sync-version.mjs",
    "update:all": "node scripts/update-all.mjs",
    "build:update_all": "node scripts/update-all.mjs --release",
    "build:update_all:mac": "node scripts/update-all.mjs --release-mac",
    "dist": "npm run build:desktop-hit && npm run build && electron-builder --win",
    "build:msi": "node scripts/build-msi.mjs",
    "build:portable": "node scripts/build-portable.mjs",
    "build:release": "node scripts/build-release.mjs",
    "build:dist:mac": "node scripts/build-dist-mac.mjs"
  },
  "dependencies": {
    "7zip-bin": "^5.2.0",
    "exceljs": "^4.4.0",
    "koffi": "^3.2.1",
    "kor-lunar": "^1.7.0",
    "node-forge": "^1.4.0",
    "pdfkit": "^0.20.2",
    "solarlunar": "^3.1.0",
    "ws": "^8.21.3"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^22.20.2",
    "@types/node-forge": "^1.3.14",
    "@types/pdfkit": "^0.17.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^5.2.0",
    "electron": "^44.3.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^7.3.6"
  },
  "build": {
    "appId": "com.neodesktopcalendar.app",
    "productName": "Neo Desktop Calendar",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "afterPack": "./scripts/after-pack.mjs",
    "files": [
      "out/**/*"
    ],
    "extraResources": [
      {
        "from": "src/renderer/public/icons",
        "to": "icons",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "node_modules/7zip-bin/LICENSE.txt",
        "to": "7zip/LICENSE.txt"
      },
      {
        "from": "resources/7zip/NOTICE.txt",
        "to": "7zip/NOTICE.txt"
      },
      {
        "from": "LICENSE",
        "to": "notices/LICENSE"
      },
      {
        "from": "legal/THIRD_PARTY_NOTICES.md",
        "to": "notices/THIRD_PARTY_NOTICES.md"
      },
      {
        "from": "src/shared/seed/holidays-kr.json",
        "to": "seed/holidays-kr.json"
      }
    ],
    "win": {
      "icon": "build/icon.ico",
      "target": [
        "nsis"
      ],
      "extraResources": [
        {
          "from": "resources/desktop-hit-helper",
          "to": "desktop-hit-helper",
          "filter": [
            "Neo-Desktop-Calendar.exe"
          ]
        },
        {
          "from": "node_modules/7zip-bin/win/x64/7za.exe",
          "to": "7zip/7za.exe"
        }
      ]
    },
    "mac": {
      "category": "public.app-category.productivity",
      "icon": "build/icon.png",
      "identity": null,
      "hardenedRuntime": false,
      "gatekeeperAssess": false,
      "target": [
        "dmg",
        "zip"
      ],
      "artifactName": "${productName} v${version}_${env.NEO_BUILD_STAMP}_macOS.${ext}",
      "extraFiles": [
        {
          "from": "build/.env.macos",
          "to": "MacOS/.env"
        }
      ],
      "extraResources": [
        {
          "from": "node_modules/7zip-bin/mac/arm64/7za",
          "to": "7zip/arm64/7za"
        },
        {
          "from": "node_modules/7zip-bin/mac/x64/7za",
          "to": "7zip/x64/7za"
        }
      ]
    },
    "dmg": {
      "artifactName": "${productName} v${version}_${env.NEO_BUILD_STAMP}_macOS.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  },
  "overrides": {
    "uuid": "^11.1.1"
  },
  "allowScripts": {
    "esbuild@0.25.12": true,
    "esbuild@0.28.1": true,
    "electron@44.3.0": true,
    "koffi@3.2.1": true
  }
}
