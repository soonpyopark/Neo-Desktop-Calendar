{
  "name": "neo-desktop-calendar",
  "version": "1.2.1",
  "description": "Neo Desktop Calendar — desktop wallpaper calendar with click-through",
  "main": "./out/main/main.js",
  "author": "Neo Desktop Calendar",
  "license": "AGPL-3.0-only",
  "scripts": {
    "dev": "electron-vite dev",
    "dev:restart": "node scripts/dev-restart.mjs",
    "browser:dev": "node scripts/open-browser-dev.mjs",
    "stop": "node scripts/kill-dev.mjs",
    "build": "electron-vite build",
    "build:desktop-hit": "node scripts/build-desktop-hit-helper.mjs",
    "preview": "electron-vite preview",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json",
    "typecheck": "npm run typecheck:node && npm run typecheck:web",
    "seed:holidays": "node scripts/build-holiday-seed.mjs",
    "verify:export": "node scripts/verify-export.mjs",
    "sync-version": "node scripts/sync-version.mjs",
    "update:all": "node scripts/update-all.mjs",
    "build:update_all": "node scripts/update-all.mjs --msi",
    "dist": "npm run build:desktop-hit && npm run build && electron-builder --win",
    "build:msi": "node scripts/build-msi.mjs",
    "build:portable": "node scripts/build-portable.mjs",
    "build:release": "node scripts/build-release.mjs"
  },
  "dependencies": {
    "7zip-bin": "^5.2.0",
    "exceljs": "^4.4.0",
    "koffi": "^2.11.0",
    "kor-lunar": "^1.7.0",
    "node-forge": "^1.4.0",
    "pdfkit": "^0.19.1",
    "solarlunar": "^3.1.0",
    "ws": "^8.21.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.11",
    "@types/node": "^22.16.5",
    "@types/node-forge": "^1.3.14",
    "@types/pdfkit": "^0.17.6",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^4.7.0",
    "electron": "^37.10.3",
    "electron-builder": "^26.0.12",
    "electron-vite": "^4.0.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "tailwindcss": "^4.1.11",
    "typescript": "^5.8.3",
    "vite": "^7.0.5"
  },
  "build": {
    "appId": "com.neodesktopcalendar.app",
    "productName": "Neo Desktop Calendar",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "out/**/*"
    ],
    "extraResources": [
      {
        "from": "src/renderer/public/icons",
        "to": "icons",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "resources/desktop-hit-helper",
        "to": "desktop-hit-helper",
        "filter": [
          "Neo-Desktop-Calendar.exe"
        ]
      },
      {
        "from": "node_modules/7zip-bin/win/x64/7za.exe",
        "to": "7zip/7za.exe"
      },
      {
        "from": "node_modules/7zip-bin/LICENSE.txt",
        "to": "7zip/LICENSE.txt"
      },
      {
        "from": "resources/7zip/NOTICE.txt",
        "to": "7zip/NOTICE.txt"
      },
      {
        "from": "LICENSE",
        "to": "notices/LICENSE"
      },
      {
        "from": "legal/THIRD_PARTY_NOTICES.md",
        "to": "notices/THIRD_PARTY_NOTICES.md"
      },
      {
        "from": "src/shared/seed/holidays-kr.json",
        "to": "seed/holidays-kr.json"
      }
    ],
    "win": {
      "icon": "build/icon.ico",
      "target": [
        "nsis"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  },
  "allowScripts": {
    "electron@37.10.3": true,
    "koffi@2.16.3": true,
    "esbuild@0.25.12": true,
    "esbuild@0.28.1": true
  }
}
