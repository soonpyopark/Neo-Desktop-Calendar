# Neo Desktop Calendar v1.2.1 — Electron
# 이 파일을 복사해 `.env`로 저장하세요.
# 읽는 위치: exe 옆, 또는 개발 시 프로젝트 루트 (위쪽으로 탐색)

# ---------------------------------------------------------------------------
# 관리자 로그인 (설정 / 로그인 화면)
# 우선순위: 환경 변수 → .env 의 MYCALENDAR_* → NEOCALENDAR_* → ADMIN_* → 기본값
# ---------------------------------------------------------------------------
MYCALENDAR_ADMIN_ID=admin
MYCALENDAR_ADMIN_PW=admin1234

# 하위 호환 별칭 (위 키가 없을 때만 사용)
# NEOCALENDAR_ADMIN_ID=admin
# NEOCALENDAR_ADMIN_PW=admin1234
# ADMIN_ID=admin
# ADMIN_PW=admin1234

# ---------------------------------------------------------------------------
# 공공데이터포털 특일 정보 API (대한민국 공휴일) — 선택
# 배포본에는 이 키를 넣지 않습니다. 3년치 휴일 시드를 다시 구울 때만(npm run seed:holidays)
# 쓰이고, 빌드는 커밋된 시드를 그대로 번들합니다.
# 설치 후 최신화가 필요하면 설정 → 대한민국의 휴일에서 본인 키로 동기화하세요.
# ---------------------------------------------------------------------------
# DATA_GO_KR_SERVICE_KEY=

# ---------------------------------------------------------------------------
# 데이터 폴더 — 기본적으로 userData (개발 시 워크스페이스 `data/` 도 가능)
# ---------------------------------------------------------------------------
# DATA_ROOT=data
# DATA_ROOT=D:/USB/my-calendar-data

# ---------------------------------------------------------------------------
# HTTP 웹 서버 (앱 기동 시 자동 시작 — 브라우저에서 편집)
# PORT 미설정 시 기본 3010. 기본 모드는 Local (HOSTNAME 생략/127.0.0.1).
# 개발 중 브라우저 테스트: npm run dev 실행 후 http://127.0.0.1:5173/ 또는 npm run browser:dev
# HOSTNAME=0.0.0.0 일 때만 Web(LAN). Local ↔ Web 은 상호배타(트레이에서 전환 시 기존 중지).
# LAN 시 Windows URL ACL·방화벽이 필요할 수 있습니다:
#   netsh http add urlacl url=http://+:3010/ user=Everyone
# 포트·모드·HTTPS는 설정 → 서버 관리 값이 .env보다 우선합니다
# (settings.json의 webServerPort / webServerMode / httpsEnabled).
# HTTPS 인증서는 데이터 폴더 하위 tls/ (ca.crt, server.crt …)에 저장됩니다.
# ---------------------------------------------------------------------------
PORT=3010
HOSTNAME=127.0.0.1
# HOSTNAME=0.0.0.0
# ALLOWED_HOSTS=*
# HTTPS_ENABLED=1
